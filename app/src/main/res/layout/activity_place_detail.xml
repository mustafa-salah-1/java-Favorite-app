<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#F8F9FA">

    <TextView
        android:id="@+id/textViewDetailTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Place Details"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#212529"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:id="@+id/textViewDetailName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Place Name"
        android:textSize="20sp"
        android:textColor="#0D6EFD"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:backgroundTint="#FFFFFF">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Coordinates"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#6C757D"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/textViewDetailCoords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lat: 0.0, Lon: 0.0"
                android:textSize="16sp"
                android:textColor="#495057"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/buttonViewOnMap"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="View on Map"
        android:textAllCaps="false"
        android:backgroundTint="#198754"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/buttonBack"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Back to List"
        android:textAllCaps="false"
        android:backgroundTint="#6C757D"
        android:textColor="#FFFFFF"
        android:textSize="16sp"/>

</LinearLayout>
